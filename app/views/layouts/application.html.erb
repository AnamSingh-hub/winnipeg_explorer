<!DOCTYPE html>
<html>
  <head>
    <title>Winnipeg Explorer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Winnipeg Explorer", root_path, class: "navbar-brand" %>

        <div class="navbar-nav">
  <%= link_to "Home", root_path, class: "nav-link" %>
  <%= link_to "Attractions", attractions_path, class: "nav-link" %>
  <%= link_to "About", pages_about_path, class: "nav-link" %>
</div>
      </div>
    </nav>

    <main class="container mt-4">
      <%= yield %>
    </main>
  </body>
</html>