<div class="p-5 mb-4 bg-light rounded-3">
  <div class="container-fluid py-4">
    <h1 class="display-4 fw-bold">Explore Winnipeg</h1>

    <p class="col-md-8 fs-5">
      Discover Winnipeg's parks, museums, landmarks and
      exciting places to visit.
    </p>

    <%= link_to "About This Project", pages_about_path,
        class: "btn btn-primary btn-lg" %>
  </div>
</div>

<h2 class="mb-4">Discover Winnipeg</h2>

<div class="row">
  <% Category.all.each do |category| %>
    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
<h5 class="card-title">
  <%= link_to category.name, attractions_path(category_id: category.id),
      class: "text-decoration-none" %>
</h5>          <p class="card-text"><%= category.description %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>